<Page x:Class="RRX.Xml.ProjectTree.PageProjectTree"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dd="clr-namespace:RRX.DragDrop;assembly=RRX.DragDrop"
      xmlns:local="clr-namespace:RRX.Xml.ProjectTree"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="ProjectTree">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="TreeStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <EventSetter Event="Collapsed" Handler="TreeItem_Collapsed" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:RrxProjectTreeItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Background="Transparent" Height="22" Margin="1">
                <Path Data="{Binding IconData}" Fill="{Binding IconBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" Fill="{Binding MatchBrush}" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding ShowMatchStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Kind}" Style="{StaticResource TreeStatusText}" />
                <TextBlock Text="{Binding Uid}" Style="{StaticResource TreeStatusText}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type local:ItemProjectTreeDefault}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" FontSize="12" />
        </HierarchicalDataTemplate>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText" Foreground="#444444" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="RRX nach ASP - Systemfolder - Component; Revit-Abgleich ueber uid" Foreground="#555555" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="RRX" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="RrxStatus" Grid.Column="1" Foreground="#666666" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Laden" Padding="10,4" Click="LoadRrx_Click" />
                        </StackPanel>
                    </Grid>

                    <TreeView x:Name="Templates"
                              Grid.Row="1"
                              VerticalAlignment="Stretch"
                              dd:DragDrop.DropTargetAdornerBrush="Red"
                              dd:DragDrop.UseDefaultDragAdorner="False"
                              dd:DragDrop.UseVisualSourceItemSizeForDragAdorner="False"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.DropScrollingMode="VerticalOnly"
                              Loaded="Tree_Loaded"
                              KeyDown="RevitTree_KeyDown"
                              RequestBringIntoView="Tree_RequestBringIntoView" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <Button Content="RRX → REVIT"
                        Padding="12,8"
                        MinWidth="92"
                        Click="SyncRrxToRevit_Click" />
                <StackPanel Margin="0,10,0,0">
                    <CheckBox x:Name="TransferDatapoints" Content="Datenpunkte" IsChecked="True" Margin="0,0,0,4" />
                    <CheckBox x:Name="TransferWires" Content="Kabel" IsChecked="True" Margin="0,0,0,4" />
                    <CheckBox x:Name="TransferArticles" Content="Artikel" IsChecked="True" Margin="0,0,0,4" />
                    <CheckBox x:Name="TransferAdditionals" Content="Zubehör" IsChecked="True" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="REVIT" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="RevitStatus" Grid.Column="1" Foreground="#666666" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0">
                            <Button Content="Lesen" Padding="10,4" Margin="0,0,6,4" Click="ReadRevit_Click" />
                            <Button Content="Gruppe lösen" Padding="10,4" Margin="0,0,6,4" Click="UngroupAutomation_Click" />
                            <Button Content="Gruppe erzeugen" Padding="10,4" Margin="0,0,6,4" Click="CreateAutomationGroup_Click" />
                            <Button Content="Entfernen" Padding="10,4" Margin="0,0,0,4" Click="RemoveRevit_Click" />
                        </WrapPanel>
                    </Grid>

                    <TreeView x:Name="Xml"
                              Grid.Row="1"
                              VerticalAlignment="Stretch"
                              dd:DragDrop.DropTargetAdornerBrush="Red"
                              dd:DragDrop.UseDefaultDragAdorner="False"
                              dd:DragDrop.UseVisualSourceItemSizeForDragAdorner="False"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.DropScrollingMode="VerticalOnly"
                              Loaded="Tree_Loaded"
                              RequestBringIntoView="Tree_RequestBringIntoView" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
